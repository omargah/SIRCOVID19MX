# Sistema
.venv/
.DS_Store
__pycache__/
*.pyc
.pytest_cache/

# Crudos de la SSA/DGE: pesan GB. Se versiona solo su procedencia (data/fuentes.csv)
# y data/raw/README.md (URL, fecha de descarga y hash SHA-256).
data/raw/**
!data/raw/README.md
!data/raw/*/
!data/raw/*/*/
!data/raw/**/.gitkeep

# Intermedios regenerables; la serie principal y el manifiesto sí se versionan
# (criterio de compassionate-dijkstra; ver docs/pendientes_integracion.md).
data/processed/cubos/
data/processed/historicos/
data/processed/eda/
data/processed/comparacion_tablero.csv

# LaTeX
escrito/*.aux
escrito/*.log
escrito/*.out
escrito/*.toc
escrito/*.bbl
escrito/*.blg
escrito/*.fls
escrito/*.fdb_latexmk
escrito/*.synctex.gz
