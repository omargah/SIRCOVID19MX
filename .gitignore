# Sistema
.venv/
.DS_Store
__pycache__/
*.pyc
.pytest_cache/

# Datos crudos de la SSA: pesan GB. Se descargan con el script de F3 y se
# documenta la URL, la fecha de descarga y el hash SHA-256 en data/raw/README.md.
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md

